system win_vxd dynamic
option quiet, map=sc55w.map
name SC55W.VXD
order clname LCODE clname CODE clname DATA clname BSS
file sc55w.o, sbcore.obj
segment class 'LCODE' preload nondiscardable
segment class 'CODE' preload nondiscardable
segment class 'DATA' preload nondiscardable
segment class 'BSS' preload nondiscardable
export SC55W_DDB.1
