@ECHO OFF
REM WCT CASE: WCSET + MENU 3D + MIDPLAY 3D with write-combining off and AUTO. CASE pm (SC55.BAT, HIMEM only)
REM or rm (SC55JEM.BAT, JEMMEX). Log C:\RESULT.LOG, last line PASS/FAIL. Built by run.sh (mkimg.sh images).
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == case %1 > C:\RESULT.LOG
IF "%1"=="rm" CALL C:\SC55\SC55JEM.BAT > C:\SBOUT.TXT
IF "%1"=="pm" CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
C:
CD \SC55
C:\HDPMI\HDPMI32I.EXE -r -x > NUL
COPY C:\WCT\WCSET.EXE C:\SC55 > NUL
ECHO -- list >> C:\RESULT.LOG
WCSET.EXE >> C:\RESULT.LOG
ECHO -- bench >> C:\RESULT.LOG
WCSET.EXE /BENCH >> C:\RESULT.LOG
ECHO -- on >> C:\RESULT.LOG
WCSET.EXE ON >> C:\RESULT.LOG
WCSET.EXE | FIND "range" >> C:\RESULT.LOG
WCSET.EXE OFF >> C:\RESULT.LOG
WCSET.EXE | FIND "range" >> C:\RESULT.LOG
WCSET.EXE AUTO >> C:\RESULT.LOG
ECHO ON=1> MENU3D.CFG
ECHO declined> TUNED.FLG
SET M3PROF=1
SET M3SECS=12
SET WCSET=OFF
ECHO -- menu3d WC off >> C:\RESULT.LOG
SC55MENU.EXE C:\SC55 > NUL
IF EXIST C:\M3PROF.TXT TYPE C:\M3PROF.TXT >> C:\RESULT.LOG
IF EXIST C:\M3PROF.TXT DEL C:\M3PROF.TXT
SET WCSET=
ECHO -- menu3d WC auto >> C:\RESULT.LOG
SC55MENU.EXE C:\SC55 > NUL
IF EXIST C:\M3PROF.TXT TYPE C:\M3PROF.TXT >> C:\RESULT.LOG
WCSET.EXE | FIND "range" >> C:\RESULT.LOG
SET M3SECS=
SET WCSET=OFF
ECHO -- midplay3d WC off >> C:\RESULT.LOG
MIDPLAY.EXE /V:2 /Q:12 /T:C:\MP0.TXT C:\WCT\METRO.MID > NUL
IF EXIST C:\MP0.TXT FIND "frames" C:\MP0.TXT >> C:\RESULT.LOG
SET WCSET=
ECHO -- midplay3d WC auto >> C:\RESULT.LOG
MIDPLAY.EXE /V:2 /Q:12 /T:C:\MP1.TXT C:\WCT\METRO.MID > NUL
IF EXIST C:\MP1.TXT FIND "frames" C:\MP1.TXT >> C:\RESULT.LOG
WCSET.EXE | FIND "range" >> C:\RESULT.LOG
ECHO -- SBDETAIL >> C:\RESULT.LOG
FIND "[wc]" SBDETAIL.TXT >> C:\RESULT.LOG
ECHO DONE PASS >> C:\RESULT.LOG
