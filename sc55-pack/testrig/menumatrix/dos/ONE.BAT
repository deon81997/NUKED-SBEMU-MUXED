@ECHO OFF
REM ONE.BAT LETTER ISO PHASE - one case: mount the ISO from the stick, install, play, unmount
ECHO CASE %1 %2 %3>> C:\UT.TXT
C:\CDSET\UCDD.EXE -unmount > NUL
C:\CDSET\UCDD.EXE -mount %2>> C:\UT.TXT
IF ERRORLEVEL 1 GOTO MFAIL
IF NOT EXIST M:\ID.TXT GOTO MFAIL
TYPE M:\ID.TXT>> C:\UT.TXT
ECHO MOUNT OK>> C:\UT.TXT
MD C:\%3%1
COPY M:\GAME\*.* C:\%3%1> NUL
IF NOT EXIST C:\%3%1\PLAY.BAT GOTO IFAIL
ECHO INSTALL OK>> C:\UT.TXT
CALL C:\%3%1\PLAY.BAT>> C:\UT.TXT
TYPE C:\MT.TXT>> C:\UT.TXT
C:\CDSET\UCDD.EXE -unmount>> C:\UT.TXT
IF ERRORLEVEL 1 GOTO UFAIL
ECHO UNMOUNT OK>> C:\UT.TXT
GOTO END
:MFAIL
ECHO MOUNT FAILED>> C:\UT.TXT
GOTO END
:IFAIL
ECHO INSTALL FAILED>> C:\UT.TXT
GOTO END
:UFAIL
ECHO UNMOUNT FAILED>> C:\UT.TXT
:END
