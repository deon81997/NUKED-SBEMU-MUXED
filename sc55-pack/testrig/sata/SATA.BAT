@ECHO OFF
REM SATA: beta.120 shared disk IRQ check. SC55.BAT, then SBDETAIL disk-controller/WARNING lines, the yellow
REM warning in SC55's output, MPUTEST and a DIR (disk still works with SBEMU loaded). Last line PASS/FAIL.
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == sata > C:\RESULT.LOG
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
FIND "disk controller" C:\SC55\SBDETAIL.TXT >> C:\RESULT.LOG
FIND "card IRQ" C:\SC55\SBDETAIL.TXT >> C:\RESULT.LOG
FIND "WARNING" C:\SC55\SBDETAIL.TXT >> C:\RESULT.LOG
FIND "shares IRQ" C:\SBOUT.TXT >> C:\RESULT.LOG
C:\SC55\MPUTEST.EXE > C:\MPU.TXT
IF ERRORLEVEL 1 GOTO BAD
DIR C:\SC55 /W > C:\DIR.TXT
IF ERRORLEVEL 1 GOTO BAD
FIND "file(s)" C:\DIR.TXT >> C:\RESULT.LOG
ECHO PASS >> C:\RESULT.LOG
GOTO END
:BAD
ECHO FAIL >> C:\RESULT.LOG
:END
