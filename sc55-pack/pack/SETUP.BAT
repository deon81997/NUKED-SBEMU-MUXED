@ECHO OFF
REM SPDX-License-Identifier: GPL-2.0-or-later - part of NUKED SB-EMU, https://github.com/deon81997/NUKED-SBEMU-MUXED
REM ======================================================================
REM  SETUP.BAT - installs SBEMU + SC-55 emulation and HDPMI32i
REM  Run from this folder (the one containing the FILES folder).
REM
REM    SETUP [drive]                copies the files; never edits CONFIG.SYS / AUTOEXEC.BAT
REM
REM  drive   target drive letter, default C
REM
REM  SC55.BAT serves protected-mode games (no memory manager). SC55JEM.BAT / SC55QMM.BAT are the
REM  optional launchers for real-mode games with JEMM+QPIEMU or QEMM (you supply those files).
REM ======================================================================
SET DRV=%1
IF "%DRV%"=="" SET DRV=C
SET DST=%DRV%:\SC55

IF NOT EXIST FILES\SC55\SBEMU.EXE GOTO NOFILES
IF NOT EXIST FILES\HDPMI\HDPMI32I.EXE GOTO NOFILES
IF NOT EXIST %DRV%:\NUL GOTO NODRIVE

ECHO Installing to %DST% ...
IF NOT EXIST %DST%\NUL MD %DST%
IF NOT EXIST %DST%\NUL GOTO MDFAIL
IF NOT EXIST %DST%\ROMS\NUL MD %DST%\ROMS
IF NOT EXIST %DST%\SF2\NUL MD %DST%\SF2
IF NOT EXIST %DST%\MOUSE\NUL MD %DST%\MOUSE
IF NOT EXIST %DRV%:\HDPMI\NUL MD %DRV%:\HDPMI

ECHO Copying files ...
COPY FILES\SC55\*.* %DST% > NUL
COPY FILES\ROMS\*.* %DST%\ROMS > NUL
COPY FILES\MOUSE\*.* %DST%\MOUSE > NUL
IF NOT EXIST %DST%\PADMAP\NUL MD %DST%\PADMAP
IF EXIST FILES\PADMAP\*.* COPY FILES\PADMAP\*.* %DST%\PADMAP > NUL
COPY FILES\HDPMI\*.* %DRV%:\HDPMI > NUL
IF NOT EXIST %DRV%:\SC55\CDDRV\NUL MD %DRV%:\SC55\CDDRV
COPY FILES\XCDROM\XCDROM.SYS %DRV%:\SC55\CDDRV > NUL
COPY FILES\XCDROM\MSCDEX.EXE %DRV%:\SC55\CDDRV > NUL
REM  MSCDEX is Microsoft's and not in the public release: take Windows 98's own copy
SET MSX=C:\WINDOWS\COMMAND\MSCDEX.EXE
IF NOT EXIST %DRV%:\SC55\CDDRV\MSCDEX.EXE IF EXIST %MSX% COPY %MSX% %DRV%:\SC55\CDDRV > NUL
SET MSX=
COPY FILES\VIDECD\*.* %DRV%:\SC55\CDDRV > NUL
COPY FILES\BOOT\BOOTCFG.BAT %DST% > NUL
COPY FILES\BOOT\JEMMCFG.BAT %DST% > NUL
COPY CLEANUP.BAT %DST% > NUL
COPY UNINSTAL.BAT %DST% > NUL
COPY README.TXT %DST% > NUL
COPY FILES\BOOT\RESET.BAT C:\ > NUL
IF NOT EXIST %DST%\DOSMODE\NUL MD %DST%\DOSMODE
COPY FILES\DOSMODE\*.* %DST%\DOSMODE > NUL
IF NOT EXIST %DST%\RM\NUL MD %DST%\RM
IF NOT EXIST %DST%\RM\JEMM\NUL MD %DST%\RM\JEMM
IF NOT EXIST %DST%\RM\QEMM\NUL MD %DST%\RM\QEMM
COPY FILES\JEMM\*.* %DST%\RM\JEMM > NUL
COPY FILES\QEMM\*.* %DST%\RM\QEMM > NUL
IF NOT EXIST %DST%\RM\JEMM\JEMMEX.EXE ECHO WARNING: JEMM files not copied to %DST%\RM\JEMM (FILES\JEMM missing?)
IF NOT EXIST %DST%\RM\JEMM\QPIEMU.DLL ECHO WARNING: QPIEMU.DLL is missing from %DST%\RM\JEMM.
IF NOT EXIST %DRV%:\GSCDROM\NUL MD %DRV%:\GSCDROM
COPY FILES\GSCDROM\*.* %DRV%:\GSCDROM > NUL
REM  The CD images screen (MENU, CD-ROM, item 2) lives in %DRV%:\CDSET. If an older pack put its own
REM  mounter there, replace it now so the screen matches this menu (CDINST does the full CD install).
IF NOT EXIST %DRV%:\CDSET\NUL GOTO NOCDSET
ECHO Updating the CD images screen in %DRV%:\CDSET ...
COPY FILES\CDSET\*.* %DRV%:\CDSET > NUL
IF NOT EXIST %DRV%:\MOUNT.BAT GOTO NOCDSET
ECHO @ECHO OFF> %DRV%:\MOUNT.BAT
ECHO CALL %DRV%:\CDSET\GUI.BAT>> %DRV%:\MOUNT.BAT
ECHO %DRV%:>> %DRV%:\MOUNT.BAT
ECHO CD \>> %DRV%:\MOUNT.BAT
:NOCDSET
IF NOT EXIST %DST%\SBEMU.EXE GOTO COPYFAIL
IF NOT EXIST %DST%\SC55LOG.EXE GOTO COPYFAIL
IF NOT EXIST %DRV%:\HDPMI\HDPMI32I.EXE GOTO COPYFAIL
IF NOT EXIST %DRV%:\SC55\CDDRV\XCDROM.SYS GOTO COPYFAIL
IF NOT EXIST %DRV%:\SC55\CDDRV\MSCDEX.EXE ECHO NOTE: put MSCDEX.EXE in %DRV%:\SC55\CDDRV for the real CD-ROM drive.
IF NOT EXIST %DRV%:\GSCDROM\GSCDROM.SYS ECHO NOTE: no GSCDROM.SYS (LG driver, optional; see DOWNLOADS.TXT).

ECHO Creating SC55.BAT and TEST.BAT ...
ECHO @ECHO OFF> %DST%\SC55.BAT
ECHO REM Starts the SC-55 MPU-401 at port 330h. Extra options can follow, e.g. SC55 /VSCGAIN:150>> %DST%\SC55.BAT
ECHO %DRV%:>> %DST%\SC55.BAT
ECHO CD \SC55>> %DST%\SC55.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\SC55.BAT
ECHO SET SBEMULOG=%DST%\SBLOG.TXT>> %DST%\SC55.BAT
ECHO CALL %DST%\SC55RUN.BAT %%1 %%2 %%3 %%4>> %DST%\SC55.BAT

ECHO @ECHO OFF> %DST%\SETTINGS.BAT
ECHO REM Menu for Sound Blaster / MPU-401 / ROM set / quality. Scanning the ROMs takes a few seconds.>> %DST%\SETTINGS.BAT
ECHO %DRV%:>> %DST%\SETTINGS.BAT
ECHO CD \SC55>> %DST%\SETTINGS.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\SETTINGS.BAT
ECHO SBSET.EXE %DST% %%1>> %DST%\SETTINGS.BAT

ECHO @ECHO OFF> %DST%\MENU.BAT
ECHO REM One menu for the whole pack. Nothing starts by itself: you pick, then the menu comes back.>> %DST%\MENU.BAT
ECHO REM The menu writes your choice to MENUGO.BAT and this file runs it from plain DOS.>> %DST%\MENU.BAT
ECHO %DRV%:>> %DST%\MENU.BAT
ECHO CD \SC55>> %DST%\MENU.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\MENU.BAT
ECHO SET MENUVIEW=>> %DST%\MENU.BAT
ECHO :AGAIN>> %DST%\MENU.BAT
ECHO %DST%\SC55MENU.EXE %DST%>> %DST%\MENU.BAT
ECHO SET MENUBACK=>> %DST%\MENU.BAT
ECHO SET MENUVIEW=>> %DST%\MENU.BAT
ECHO IF NOT EXIST %DST%\MENUGO.BAT GOTO END>> %DST%\MENU.BAT
ECHO CALL %DST%\MENUGO.BAT>> %DST%\MENU.BAT
ECHO %DRV%:>> %DST%\MENU.BAT
ECHO CD \SC55>> %DST%\MENU.BAT
ECHO IF "%%MENUBACK%%"=="1" GOTO AGAIN>> %DST%\MENU.BAT
ECHO :END>> %DST%\MENU.BAT
ECHO IF EXIST %DST%\MENUGO.BAT DEL %DST%\MENUGO.BAT>> %DST%\MENU.BAT
ECHO SET MENUBACK=>> %DST%\MENU.BAT
ECHO SET MENUVIEW=>> %DST%\MENU.BAT

ECHO @ECHO OFF> %DST%\SC55JEM.BAT
ECHO REM SC-55 for real-mode AND protected-mode games with JEMM + QPIEMU.>> %DST%\SC55JEM.BAT
ECHO REM JEMMEX (or JEMM386) must already be loaded from CONFIG.SYS: see %DST%\DOSMODE\REALMODE.TXT.>> %DST%\SC55JEM.BAT
ECHO %DRV%:>> %DST%\SC55JEM.BAT
ECHO CD \SC55>> %DST%\SC55JEM.BAT
ECHO IF NOT EXIST %DST%\RM\JEMM\JLOAD.EXE GOTO NOFILES>> %DST%\SC55JEM.BAT
ECHO IF NOT EXIST %DST%\RM\JEMM\QPIEMU.DLL GOTO NOFILES>> %DST%\SC55JEM.BAT
ECHO %DST%\RM\JEMM\JLOAD.EXE %DST%\RM\JEMM\QPIEMU.DLL>> %DST%\SC55JEM.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\SC55JEM.BAT
ECHO SET SBEMULOG=%DST%\SBLOG.TXT>> %DST%\SC55JEM.BAT
ECHO CALL %DST%\SC55RUN.BAT %%1 %%2 %%3 %%4>> %DST%\SC55JEM.BAT
ECHO GOTO END>> %DST%\SC55JEM.BAT
ECHO :NOFILES>> %DST%\SC55JEM.BAT
ECHO ECHO Put JLOAD.EXE and QPIEMU.DLL in %DST%\RM\JEMM  (see %DST%\DOSMODE\REALMODE.TXT).>> %DST%\SC55JEM.BAT
ECHO :END>> %DST%\SC55JEM.BAT

ECHO @ECHO OFF> %DST%\SC55J16.BAT
ECHO REM Like SC55JEM.BAT, plus 16-bit protected-mode games (Jazz Jackrabbit and other Borland 16-bit DPMI>> %DST%\SC55J16.BAT
ECHO REM games): HDPMI16I first, then HDPMI32I, SBEMU, and SBEMU16 which passes their sound/joystick ports on.>> %DST%\SC55J16.BAT
ECHO %DRV%:>> %DST%\SC55J16.BAT
ECHO CD \SC55>> %DST%\SC55J16.BAT
ECHO IF NOT EXIST %DST%\RM\JEMM\QPIEMU.DLL GOTO NOFILES>> %DST%\SC55J16.BAT
ECHO IF NOT EXIST %DRV%:\HDPMI\HDPMI16I.EXE GOTO NOFILES>> %DST%\SC55J16.BAT
ECHO %DST%\RM\JEMM\JLOAD.EXE %DST%\RM\JEMM\QPIEMU.DLL>> %DST%\SC55J16.BAT
ECHO %DRV%:\HDPMI\HDPMI16I.EXE -r>> %DST%\SC55J16.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\SC55J16.BAT
ECHO SET SBEMULOG=%DST%\SBLOG.TXT>> %DST%\SC55J16.BAT
ECHO CALL %DST%\SC55RUN.BAT %%1 %%2 %%3 %%4>> %DST%\SC55J16.BAT
ECHO %DST%\SBEMU16.COM>> %DST%\SC55J16.BAT
ECHO GOTO END>> %DST%\SC55J16.BAT
ECHO :NOFILES>> %DST%\SC55J16.BAT
ECHO ECHO Needs %DST%\RM\JEMM\QPIEMU.DLL and %DRV%:\HDPMI\HDPMI16I.EXE (run SETUP again).>> %DST%\SC55J16.BAT
ECHO :END>> %DST%\SC55J16.BAT

ECHO @ECHO OFF> %DST%\SC55QMM.BAT
ECHO REM SC-55 for real-mode AND protected-mode games with QEMM.>> %DST%\SC55QMM.BAT
ECHO REM QEMM386.SYS must already be loaded from CONFIG.SYS: see %DST%\DOSMODE\REALMODE.TXT.>> %DST%\SC55QMM.BAT
ECHO %DRV%:>> %DST%\SC55QMM.BAT
ECHO CD \SC55>> %DST%\SC55QMM.BAT
ECHO IF EXIST %DST%\RM\QEMM\QEMM386.SYS GOTO QOK>> %DST%\SC55QMM.BAT
ECHO ECHO Note: no QEMM files in %DST%\RM\QEMM (fine if QEMM is elsewhere)>> %DST%\SC55QMM.BAT
ECHO :QOK>> %DST%\SC55QMM.BAT
ECHO %DRV%:\HDPMI\HDPMI32I.EXE -r -x>> %DST%\SC55QMM.BAT
ECHO SET SBEMULOG=%DST%\SBLOG.TXT>> %DST%\SC55QMM.BAT
ECHO CALL %DST%\SC55RUN.BAT %%1 %%2 %%3 %%4>> %DST%\SC55QMM.BAT

ECHO @ECHO OFF> %DST%\CDROM.BAT
ECHO REM Gives the real CD-ROM drive a letter (D: if free) with MSCDEX. Works with whichever CD-ROM>> %DST%\CDROM.BAT
ECHO REM driver CONFIG.SYS loaded: XCDROM (XCD0001), VIDE-CDD (MSCD001), LG (MSCD000), Oak (OAKCD).>> %DST%\CDROM.BAT
ECHO REM CDCHK.COM asks MSCDEX if it is loaded (errorlevel = number of CD drives). Testing D:\NUL>> %DST%\CDROM.BAT
ECHO REM instead would hang for up to a minute when D: is already the CD-ROM.>> %DST%\CDROM.BAT
ECHO SET CDN=>> %DST%\CDROM.BAT
ECHO IF "%%CDVM%%"=="1" GOTO VIRT>> %DST%\CDROM.BAT
ECHO %DST%\CDCHK.COM>> %DST%\CDROM.BAT
ECHO IF ERRORLEVEL 1 GOTO HAVE>> %DST%\CDROM.BAT
ECHO IF EXIST XCD0001 SET CDN=XCD0001>> %DST%\CDROM.BAT
ECHO IF EXIST MSCD001 SET CDN=MSCD001>> %DST%\CDROM.BAT
ECHO IF EXIST MSCD000 SET CDN=MSCD000>> %DST%\CDROM.BAT
ECHO IF EXIST OAKCD SET CDN=OAKCD>> %DST%\CDROM.BAT
ECHO IF "%%CDN%%"=="" GOTO NODRV>> %DST%\CDROM.BAT
ECHO IF EXIST D:\NUL GOTO INUSE>> %DST%\CDROM.BAT
ECHO %DRV%:\SC55\CDDRV\MSCDEX.EXE /D:%%CDN%% /L:D>> %DST%\CDROM.BAT
ECHO GOTO CHK>> %DST%\CDROM.BAT
ECHO :INUSE>> %DST%\CDROM.BAT
ECHO ECHO D: is already in use - the CD-ROM gets the next free letter.>> %DST%\CDROM.BAT
ECHO %DRV%:\SC55\CDDRV\MSCDEX.EXE /D:%%CDN%%>> %DST%\CDROM.BAT
ECHO :CHK>> %DST%\CDROM.BAT
ECHO GOTO END>> %DST%\CDROM.BAT
ECHO :HAVE>> %DST%\CDROM.BAT
ECHO ECHO MSCDEX is already loaded: the CD-ROM already has its drive letter.>> %DST%\CDROM.BAT
ECHO GOTO END>> %DST%\CDROM.BAT
ECHO :VIRT>> %DST%\CDROM.BAT
ECHO ECHO The virtual CD drive (M:) is on. It also gave the real CD-ROM a letter>> %DST%\CDROM.BAT
ECHO ECHO (D: or the next free one) if its driver was loaded from CONFIG.SYS.>> %DST%\CDROM.BAT
ECHO GOTO END>> %DST%\CDROM.BAT
ECHO :NODRV>> %DST%\CDROM.BAT
ECHO ECHO No CD-ROM driver is loaded. Load one from CONFIG.SYS first:>> %DST%\CDROM.BAT
ECHO ECHO   %DST%\BOOTCFG.BAT does it, or see %DST%\DOSMODE\CDROM-D810.TXT>> %DST%\CDROM.BAT
ECHO ECHO Disc images need no driver: MENU, CD-ROM, CD images.>> %DST%\CDROM.BAT
ECHO :END>> %DST%\CDROM.BAT
ECHO SET CDN=>> %DST%\CDROM.BAT

ECHO @ECHO OFF> %DST%\CDROMLG.BAT
ECHO REM Kept for old shortcuts: CDROM.BAT now finds the LG driver (and the others) by itself.>> %DST%\CDROMLG.BAT
ECHO CALL %DST%\CDROM.BAT>> %DST%\CDROMLG.BAT

ECHO @ECHO OFF> %DST%\TEST.BAT
ECHO REM Checks that your ROMs boot and measures speed. Writes SC55LOG.TXT in this folder.>> %DST%\TEST.BAT
ECHO %DRV%:>> %DST%\TEST.BAT
ECHO CD \SC55>> %DST%\TEST.BAT
ECHO SC55LOG.EXE ROMS %%1 %%2 %%3>> %DST%\TEST.BAT
ECHO ECHO Report saved in %DST%\SC55LOG.TXT>> %DST%\TEST.BAT

GOTO DONE

:DONE
ECHO.
ECHO Done. Installed in %DST%  (HDPMI: %DRV%:\HDPMI, CD-ROM drivers: %DST%\CDDRV)
ECHO CONFIG.SYS and AUTOEXEC.BAT were NOT changed.
ECHO.
ECHO   %DST%\MENU.BAT       one menu for everything: SC-55, settings, tests, games
ECHO   %DST%\SC55.BAT       starts the SC-55 by hand
ECHO   %DST%\SETTINGS.BAT   Sound Blaster / MPU-401 port, IRQ, DMA, synth
ECHO   %DST%\TEST.BAT       checks the ROMs boot, measures speed (SC55LOG.TXT)
ECHO   %DST%\MPUTEST.EXE    plays a test tune once the SC-55 is running
ECHO   %DST%\SC55JEM.BAT    real-mode games (JEMM+QPIEMU), also SC55QMM.BAT (QEMM)
ECHO                        see %DST%\DOSMODE\REALMODE.TXT
ECHO   %DST%\SC55J16.BAT    as SC55JEM, plus 16-bit protected-mode games (Jazz Jackrabbit)
ECHO   %DST%\DOSMODE\CDROM-D810.TXT   real CD-ROM in DOS without boot file edits
ECHO   %DST%\BOOTCFG.BAT    optional: CD-ROM driver at every start (undo: C:\RESET)
ECHO   %DST%\UNINSTAL.BAT   removes everything and restores the boot files
ECHO.
ECHO Restart in MS-DOS mode / plain DOS, then run %DST%\MENU.BAT.
GOTO END

:NOFILES
ECHO Run SETUP from the folder that contains the FILES folder (FILES\SC55, FILES\HDPMI).
GOTO END
:NODRIVE
ECHO Drive %DRV%: does not exist.
GOTO END
:MDFAIL
ECHO Could not create %DST%. Is the drive writable?
GOTO END
:COPYFAIL
ECHO A copy failed. Is there free space on %DRV%: (about 20 MB needed)?
:END
SET DRV=
SET DST=
