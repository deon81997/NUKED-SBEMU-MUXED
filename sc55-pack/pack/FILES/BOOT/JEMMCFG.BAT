@ECHO OFF
REM SPDX-License-Identifier: GPL-2.0-or-later - part of NUKED SB-EMU, https://github.com/deon81997/NUKED-SBEMU-MUXED
REM ======================================================================
REM  JEMMCFG.BAT - OPTIONAL. Adds a 2-line start menu to CONFIG.SYS:
REM     1. Windows 98            (your old CONFIG.SYS / AUTOEXEC.BAT, unchanged; the default)
REM     2. DOS with JEMMEX       (JEMMEX + optional CD-ROM, then a DOS prompt - Windows does
REM                               NOT start, because JEMM cannot run Windows 98)
REM  Nothing is started automatically: in choice 2 you run C:\SC55\SC55JEM yourself.
REM
REM    JEMMCFG        JEMMEX only
REM    JEMMCFG X      JEMMEX + CD-ROM driver XCDROM (UltraDMA off)
REM    JEMMCFG V      JEMMEX + CD-ROM driver VIDE-CDD (PIO, secondary IDE)
REM
REM  Undo everything with  C:\RESET.BAT   (same backups as BOOTCFG.BAT)
REM ======================================================================
SET JC_CD=
IF "%1"=="X" SET JC_CD=X
IF "%1"=="x" SET JC_CD=X
IF "%1"=="V" SET JC_CD=V
IF "%1"=="v" SET JC_CD=V

IF EXIST C:\SC55BOOT.FLG GOTO ALREADY
IF NOT EXIST C:\SC55\RM\JEMM\JEMMEX.EXE GOTO NOJEMM
IF "%JC_CD%"=="" GOTO CDOK
IF NOT EXIST C:\SC55\CDDRV\MSCDEX.EXE GOTO NOCD
IF "%JC_CD%"=="X" IF NOT EXIST C:\SC55\CDDRV\XCDROM.SYS GOTO NOCD
IF "%JC_CD%"=="V" IF NOT EXIST C:\SC55\CDDRV\VIDE-CDD.SYS GOTO NOCD
:CDOK
IF NOT EXIST C:\COMMAND.COM GOTO NOCMD
IF NOT EXIST C:\CONFIG.SYS GOTO SECTOK
TYPE C:\CONFIG.SYS | FIND "[" > NUL
IF NOT ERRORLEVEL 1 GOTO HASSECT
:SECTOK

ECHO Backing up CONFIG.SYS and AUTOEXEC.BAT ...
IF EXIST C:\CONFIG.SYS ATTRIB -R -H -S C:\CONFIG.SYS
IF EXIST C:\AUTOEXEC.BAT ATTRIB -R -H -S C:\AUTOEXEC.BAT
IF EXIST C:\CONFIG.SYS TYPE C:\CONFIG.SYS > C:\CONFIG.PRE
IF EXIST C:\CONFIG.SYS GOTO BK1
ECHO none> C:\CONFIG.NON
:BK1
IF EXIST C:\AUTOEXEC.BAT TYPE C:\AUTOEXEC.BAT > C:\AUTOEXEC.PRE
IF EXIST C:\AUTOEXEC.BAT GOTO BK2
ECHO none> C:\AUTOEXEC.NON
:BK2
IF NOT EXIST C:\CONFIG.SYS GOTO CHKB2
IF NOT EXIST C:\CONFIG.PRE GOTO BACKFAIL
:CHKB2
IF NOT EXIST C:\AUTOEXEC.BAT GOTO CHKB3
IF NOT EXIST C:\AUTOEXEC.PRE GOTO BACKFAIL
:CHKB3

ECHO Building the new CONFIG.SYS ...
ECHO [MENU]> C:\CONFIG.NEW
ECHO MENUITEM=WIN98, Windows 98>> C:\CONFIG.NEW
ECHO MENUITEM=JEMM, DOS with JEMMEX (SC-55 for real-mode games)>> C:\CONFIG.NEW
ECHO MENUDEFAULT=WIN98,5>> C:\CONFIG.NEW
ECHO.>> C:\CONFIG.NEW
ECHO [WIN98]>> C:\CONFIG.NEW
IF EXIST C:\CONFIG.PRE TYPE C:\CONFIG.PRE >> C:\CONFIG.NEW
ECHO.>> C:\CONFIG.NEW
ECHO [JEMM]>> C:\CONFIG.NEW
ECHO DEVICE=C:\SC55\RM\JEMM\JEMMEX.EXE X2MAX=8192 NOEMS>> C:\CONFIG.NEW
ECHO DOS=HIGH,UMB>> C:\CONFIG.NEW
ECHO LASTDRIVE=Z>> C:\CONFIG.NEW
IF "%JC_CD%"=="X" ECHO DEVICEHIGH=C:\SC55\CDDRV\XCDROM.SYS /D:XCD0001 /UX>> C:\CONFIG.NEW
IF "%JC_CD%"=="V" ECHO DEVICEHIGH=C:\SC55\CDDRV\VIDE-CDD.SYS /D:MSCD001 /P:170,15>> C:\CONFIG.NEW

ECHO Building the new AUTOEXEC.BAT ...
ECHO @ECHO OFF> C:\AUTOEXEC.NEW
ECHO REM SC55PACK JEMMCFG - undo with C:\RESET.BAT>> C:\AUTOEXEC.NEW
ECHO IF "%%SC55SH%%"=="1" GOTO SC55END>> C:\AUTOEXEC.NEW
ECHO IF "%%CONFIG%%"=="JEMM" GOTO SC55JEMM>> C:\AUTOEXEC.NEW
IF EXIST C:\AUTOEXEC.PRE TYPE C:\AUTOEXEC.PRE >> C:\AUTOEXEC.NEW
ECHO.>> C:\AUTOEXEC.NEW
ECHO GOTO SC55END>> C:\AUTOEXEC.NEW
ECHO :SC55JEMM>> C:\AUTOEXEC.NEW
ECHO SET PATH=C:\WINDOWS;C:\WINDOWS\COMMAND;C:\SC55>> C:\AUTOEXEC.NEW
IF "%JC_CD%"=="X" ECHO LH C:\SC55\CDDRV\MSCDEX.EXE /D:XCD0001 /L:D>> C:\AUTOEXEC.NEW
IF "%JC_CD%"=="V" ECHO LH C:\SC55\CDDRV\MSCDEX.EXE /D:MSCD001 /L:D>> C:\AUTOEXEC.NEW
ECHO C:>> C:\AUTOEXEC.NEW
ECHO CD \SC55>> C:\AUTOEXEC.NEW
ECHO ECHO.>> C:\AUTOEXEC.NEW
ECHO ECHO DOS with JEMMEX. Type SC55JEM to start the SC-55, then start your game.>> C:\AUTOEXEC.NEW
ECHO ECHO Windows 98 does not start from here: restart and pick Windows 98.>> C:\AUTOEXEC.NEW
ECHO SET SC55SH=1>> C:\AUTOEXEC.NEW
ECHO C:\COMMAND.COM C:\ /E:2048 /P>> C:\AUTOEXEC.NEW
ECHO :SC55END>> C:\AUTOEXEC.NEW

IF NOT EXIST C:\CONFIG.NEW GOTO BUILDFAIL
IF NOT EXIST C:\AUTOEXEC.NEW GOTO BUILDFAIL
COPY C:\CONFIG.NEW C:\CONFIG.SYS > NUL
COPY C:\AUTOEXEC.NEW C:\AUTOEXEC.BAT > NUL
DEL C:\CONFIG.NEW
DEL C:\AUTOEXEC.NEW
ECHO done> C:\SC55BOOT.FLG
ECHO.
ECHO Done. At every start a menu appears for 5 seconds:
ECHO   1. Windows 98            (default - starts exactly as before)
ECHO   2. DOS with JEMMEX       (then type SC55JEM, then your game)
ECHO Your old files are saved as C:\CONFIG.PRE and C:\AUTOEXEC.PRE.
ECHO To undo everything:  C:\RESET.BAT
GOTO END

:ALREADY
ECHO BOOTCFG or JEMMCFG was already run. Run C:\RESET.BAT first, then JEMMCFG again.
GOTO END
:NOJEMM
ECHO C:\SC55\RM\JEMM\JEMMEX.EXE is missing. Run SETUP.BAT from the pack first.
GOTO END
:NOCD
ECHO The CD-ROM driver or MSCDEX is missing in C:\SC55\CDDRV. Run SETUP.BAT first.
GOTO END
:NOCMD
ECHO C:\COMMAND.COM was not found. Nothing was changed.
GOTO END
:HASSECT
ECHO Your CONFIG.SYS already has [sections] (a menu). Nothing was changed.
GOTO END
:BACKFAIL
ECHO Could not back up your files. Nothing was changed.
GOTO END
:BUILDFAIL
ECHO Could not build the new files (disk full?). CONFIG.SYS and AUTOEXEC.BAT were NOT changed.
:END
SET JC_CD=
