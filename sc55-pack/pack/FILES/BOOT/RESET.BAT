@ECHO OFF
REM ======================================================================
REM  RESET.BAT - puts CONFIG.SYS and AUTOEXEC.BAT back the way they were before BOOTCFG.BAT / JEMMCFG.BAT.
REM  Lives in C:\ . Safe to run more than once.
REM ======================================================================
IF NOT EXIST C:\SC55BOOT.FLG GOTO NOTHING
IF EXIST C:\CONFIG.SYS ATTRIB -R -H -S C:\CONFIG.SYS
IF EXIST C:\AUTOEXEC.BAT ATTRIB -R -H -S C:\AUTOEXEC.BAT
IF EXIST C:\CONFIG.PRE TYPE C:\CONFIG.PRE > C:\CONFIG.SYS
IF EXIST C:\CONFIG.NON DEL C:\CONFIG.SYS
IF EXIST C:\AUTOEXEC.PRE TYPE C:\AUTOEXEC.PRE > C:\AUTOEXEC.BAT
IF EXIST C:\AUTOEXEC.NON DEL C:\AUTOEXEC.BAT
IF EXIST C:\CONFIG.PRE GOTO CHKCFG
GOTO DELBK
:CHKCFG
FC C:\CONFIG.PRE C:\CONFIG.SYS > NUL
IF ERRORLEVEL 1 GOTO FAILED
:DELBK
IF EXIST C:\CONFIG.PRE DEL C:\CONFIG.PRE
IF EXIST C:\CONFIG.NON DEL C:\CONFIG.NON
IF EXIST C:\AUTOEXEC.PRE DEL C:\AUTOEXEC.PRE
IF EXIST C:\AUTOEXEC.NON DEL C:\AUTOEXEC.NON
IF EXIST C:\SC55BOOT.FLG DEL C:\SC55BOOT.FLG
ECHO CONFIG.SYS and AUTOEXEC.BAT are back to what they were. Restart the PC.
GOTO END
:NOTHING
ECHO Nothing to reset: BOOTCFG/JEMMCFG has not changed your boot files (no C:\SC55BOOT.FLG).
GOTO END
:FAILED
ECHO The restored CONFIG.SYS does not match the backup. The backups were kept (C:\CONFIG.PRE, C:\AUTOEXEC.PRE).
:END
