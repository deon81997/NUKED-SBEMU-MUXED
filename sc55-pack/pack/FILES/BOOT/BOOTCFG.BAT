@ECHO OFF
REM ======================================================================
REM  BOOTCFG.BAT - OPTIONAL. No menu. Adds the CD-ROM driver to CONFIG.SYS and MSCDEX to
REM  AUTOEXEC.BAT so the real CD-ROM drive (D:) works in DOS. Windows 98 still starts as usual.
REM  For a DOS prompt at startup: hold CTRL (or F8) at boot and pick Command prompt only.
REM
REM    BOOTCFG X      CD-ROM driver XCDROM (UltraDMA off)
REM    BOOTCFG V      CD-ROM driver VIDE-CDD (PIO only, secondary IDE channel)
REM    BOOTCFG L      CD-ROM driver GSCDROM (LG)
REM
REM  Undo everything with  C:\RESET.BAT
REM  It backs up your files first (C:\CONFIG.PRE, C:\AUTOEXEC.PRE) and refuses to run if it has
REM  been run before without RESET.BAT.
REM ======================================================================
IF "%1"=="X" GOTO SETX
IF "%1"=="x" GOTO SETX
IF "%1"=="V" GOTO SETV
IF "%1"=="v" GOTO SETV
IF "%1"=="L" GOTO SETL
IF "%1"=="l" GOTO SETL
GOTO USAGE

:SETX
SET BC_NAME=XCD0001
SET BC_FILE=C:\SC55\CDDRV\XCDROM.SYS
GOTO CHECK
:SETV
SET BC_NAME=MSCD001
SET BC_FILE=C:\SC55\CDDRV\VIDE-CDD.SYS
GOTO CHECK
:SETL
SET BC_NAME=MSCD000
SET BC_FILE=C:\GSCDROM\GSCDROM.SYS

:CHECK
IF EXIST C:\SC55BOOT.FLG GOTO ALREADY
IF NOT EXIST %BC_FILE% GOTO NOFILES
IF NOT EXIST C:\SC55\CDDRV\MSCDEX.EXE GOTO NOFILES
IF NOT EXIST C:\CONFIG.SYS GOTO SECTOK
TYPE C:\CONFIG.SYS | FIND "[" > NUL
IF NOT ERRORLEVEL 1 GOTO HASSECT
:SECTOK

ECHO Backing up CONFIG.SYS and AUTOEXEC.BAT ...
IF EXIST C:\CONFIG.SYS ATTRIB -R -H -S C:\CONFIG.SYS
IF EXIST C:\AUTOEXEC.BAT ATTRIB -R -H -S C:\AUTOEXEC.BAT
IF EXIST C:\CONFIG.SYS TYPE C:\CONFIG.SYS > C:\CONFIG.PRE
IF EXIST C:\CONFIG.SYS GOTO BK1
ECHO none> C:\CONFIG.NON
:BK1
IF EXIST C:\AUTOEXEC.BAT TYPE C:\AUTOEXEC.BAT > C:\AUTOEXEC.PRE
IF EXIST C:\AUTOEXEC.BAT GOTO BK2
ECHO none> C:\AUTOEXEC.NON
:BK2
IF NOT EXIST C:\CONFIG.SYS GOTO CHKB2
IF NOT EXIST C:\CONFIG.PRE GOTO BACKFAIL
:CHKB2
IF NOT EXIST C:\AUTOEXEC.BAT GOTO CHKB3
IF NOT EXIST C:\AUTOEXEC.PRE GOTO BACKFAIL
:CHKB3

ECHO Building the new files ...
IF EXIST C:\CONFIG.PRE TYPE C:\CONFIG.PRE > C:\CONFIG.NEW
ECHO.>> C:\CONFIG.NEW
REM  LASTDRIVE=Z leaves room for the virtual CD drive M: (CD images)
ECHO LASTDRIVE=Z>> C:\CONFIG.NEW
IF "%BC_NAME%"=="XCD0001" GOTO LX
IF "%BC_NAME%"=="MSCD001" GOTO LV
ECHO DEVICE=C:\GSCDROM\GSCDROM.SYS /D:MSCD000>> C:\CONFIG.NEW
GOTO LDONE
:LX
ECHO DEVICE=C:\SC55\CDDRV\XCDROM.SYS /D:XCD0001 /UX>> C:\CONFIG.NEW
GOTO LDONE
:LV
ECHO DEVICE=C:\SC55\CDDRV\VIDE-CDD.SYS /D:MSCD001 /P:170,15>> C:\CONFIG.NEW
:LDONE

ECHO REM SC55PACK BOOTCFG START - undo with C:\RESET.BAT> C:\AUTOEXEC.NEW
ECHO C:\SC55\CDDRV\MSCDEX.EXE /D:%BC_NAME% /L:D>> C:\AUTOEXEC.NEW
IF EXIST C:\AUTOEXEC.PRE TYPE C:\AUTOEXEC.PRE >> C:\AUTOEXEC.NEW

IF NOT EXIST C:\CONFIG.NEW GOTO BUILDFAIL
IF NOT EXIST C:\AUTOEXEC.NEW GOTO BUILDFAIL
COPY C:\CONFIG.NEW C:\CONFIG.SYS > NUL
COPY C:\AUTOEXEC.NEW C:\AUTOEXEC.BAT > NUL
DEL C:\CONFIG.NEW
DEL C:\AUTOEXEC.NEW
ECHO done> C:\SC55BOOT.FLG
ECHO.
ECHO Done. The CD-ROM driver loads at every start (no menu); Windows starts as usual.
ECHO Your old files are saved as C:\CONFIG.PRE and C:\AUTOEXEC.PRE.
ECHO To undo everything:  C:\RESET.BAT   (if Windows will not start, F8 > Command prompt only, then RESET)
GOTO END

:USAGE
ECHO Usage:  BOOTCFG X  (XCDROM)   BOOTCFG V  (VIDE-CDD)   BOOTCFG L  (LG GSCDROM)
ECHO Undo:   C:\RESET.BAT
GOTO END
:ALREADY
ECHO BOOTCFG was already run. Run C:\RESET.BAT first if you want to change the driver.
GOTO END
:NOFILES
ECHO The driver or MSCDEX is missing in C:\SC55\CDDRV (or C:\GSCDROM). Run SETUP.BAT first.
GOTO END
:HASSECT
ECHO Your CONFIG.SYS already has [sections] (a menu). Not changed. Add the CD-ROM lines by hand.
GOTO END
:BACKFAIL
ECHO Could not back up your files. Nothing was changed.
GOTO END
:BUILDFAIL
ECHO Could not build the new files (disk full or read-only?). Your CONFIG.SYS and AUTOEXEC.BAT were NOT changed.
:END
SET BC_NAME=
SET BC_FILE=
