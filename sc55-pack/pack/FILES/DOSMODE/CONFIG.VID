REM VIDE-CDD: PIO-only ATAPI driver (no UltraDMA, uses the IDE interrupt). Very safe on laptops.
REM /P:170,15 = secondary IDE channel (where the D810's bay drive normally is). Remove /P to search all channels.
DEVICE=C:\WINDOWS\HIMEM.SYS
DEVICE=C:\SC55\CDDRV\VIDE-CDD.SYS /D:MSCD001 /P:170,15
REM LASTDRIVE=Z leaves room for the virtual CD drive M: (CD images, CDON.BAT).
LASTDRIVE=Z
