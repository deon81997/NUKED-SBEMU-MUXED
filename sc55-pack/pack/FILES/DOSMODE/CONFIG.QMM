REM Paste into: Properties > Program > Advanced > "Specify a new MS-DOS configuration" > Configuration... (Config.sys box).
REM Real-mode + protected-mode SC-55 with QEMM. Applies ONLY to the MS-DOS-mode shortcut; your real CONFIG.SYS is not changed.
REM Use the QEMM386.SYS options you normally use (RAM or ROM, etc.); the files are in C:\SC55\RM\QEMM.
DEVICE=C:\SC55\RM\QEMM\QEMM386.SYS RAM
DOS=HIGH,UMB
REM Optional real CD-ROM (see CDROM-D810.TXT):
REM DEVICEHIGH=C:\SC55\CDDRV\XCDROM.SYS /D:XCD0001 /UX

REM LASTDRIVE=Z leaves room for the virtual CD drive M: (CD images, CDON.BAT).
LASTDRIVE=Z
